# ─────────────────────────────────────────────────────────────────────────────
# Heavy artifacts — distributed via HF/Zenodo, not git
# ─────────────────────────────────────────────────────────────────────────────
trained_models/
# symlinks into trained_models/layer_*/{run}/analysis/, plus pulled cluster
# artefacts (analysis/esm35m_l6/). Git only honours `#` at the start of a
# line, so this comment must not sit on the pattern itself.
analysis/
feature_data_test_20/
feature_data_test_500/
feature_data_cluster/
feature_data_matryoshka_l4/
results/
models/
data/
wandb/

# Local PDB / motif caches
protein_results/alphafold_analysis/pdb_cache/
protein_results/residue_motifs/

# ─────────────────────────────────────────────────────────────────────────────
# Build / cache / IDE / OS
# ─────────────────────────────────────────────────────────────────────────────
*.egg-info/
.pytest_cache/
.DS_Store
__pycache__/
*.pyc

# ─────────────────────────────────────────────────────────────────────────────
# Runtime logs and binary scratch outputs
# ─────────────────────────────────────────────────────────────────────────────
nohup.out
*.log
*.npy

# ─────────────────────────────────────────────────────────────────────────────
# Cluster job manifests and per-run runbooks are local operational notes and
# are never committed. (Dockerfile.pipeline and INSTRUCTIONS.md remain tracked
# as the generic, placeholder-only reference.)
# ─────────────────────────────────────────────────────────────────────────────
k8s/*.yaml
k8s/CLUSTER_INSTRUCTIONS_*.md
k8s/*.txt

# ─────────────────────────────────────────────────────────────────────────────
# Other YAML configs are local — only the canonical training sweep
# configs are tracked.
# ─────────────────────────────────────────────────────────────────────────────
*.yaml
!relu_sweep.yaml
!matryoshka_sweep_config.yaml
